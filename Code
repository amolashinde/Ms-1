import numpy as np


def create_temperature_array(values):
    arr = np.array(values, dtype=np.float64)

    result = arr

    return result


def validate_temperature_array(arr):

    if arr.size == 0:
        result = False

    elif not np.issubdtype(arr.dtype, np.number):
        result = False

    elif np.all((arr >= -30.0) & (arr <= 10.0)):
        result = True

    else:
        result = False

    return result


def compute_temperature_stats(arr):

    mean = round(np.mean(arr), 2)

    std = round(np.std(arr), 2)

    maximum = round(np.max(arr), 2)

    minimum = round(np.min(arr), 2)

    result = (
        float(mean),
        float(std),
        float(maximum),
        float(minimum)
    )

    return result


def categorize_temperatures(arr):

    result = np.empty(arr.shape, dtype="<U7")

    result[
        (arr >= -30.0) & (arr <= -18.0)
    ] = "Frozen"

    result[
        (arr > -18.0) & (arr <= 5.0)
    ] = "Chilled"

    result[
        (arr > 5.0) & (arr <= 10.0)
    ] = "Warning"

    result[
        (arr < -30.0) | (arr > 10.0)
    ] = "Invalid"

    return result


def longest_warning_streak(arr):

    current = 0

    longest = 0

    for value in arr:

        if value > 5.0 and value <= 10.0:

            current = current + 1

            if current > longest:
                longest = current

        else:
            current = 0

    result = longest

    return result

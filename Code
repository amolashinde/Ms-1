import pandas as pd

class SolarMaintenanceAnalyzer:

    def create_inspections_df(self, inspection_data):
        df = pd.DataFrame(
            inspection_data,
            columns=[
                "InspectionID",
                "SiteID",
                "Region",
                "InspectionDate",
                "OutputMWh",
                "DowntimeHours",
                "MaintenanceStatus"
            ]
        )
        return df

    def clean_inspection_data(self, df):
        df = df.dropna()

        df = df[
            (df["OutputMWh"] > 0) &
            (df["DowntimeHours"] >= 0) &
            (df["MaintenanceStatus"].isin(["Completed", "Scheduled"]))
        ]

        df = df.reset_index(drop=True)

        return df

    def add_attention_flag(self, df, downtime_threshold):
        df = df.copy()

        df["NeedsAttention"] = (
            df["DowntimeHours"] > downtime_threshold
        ).astype(int)

        return df

    def site_performance_summary(self, df):
        df = df.groupby("SiteID").agg(
            InspectionCount=("SiteID", "count"),
            TotalOutputMWh=("OutputMWh", "sum"),
            AverageDowntime=("DowntimeHours", "mean")
        ).reset_index()

        df["AverageDowntime"] = df["AverageDowntime"].round(2)

        df = df.sort_values("SiteID").reset_index(drop=True)

        return df

    def low_output_sites(self, df, output_threshold):
        df = df.groupby("SiteID")["OutputMWh"].sum().reset_index()

        df = df[df["OutputMWh"] < output_threshold]

        df = df.rename(
            columns={"OutputMWh": "TotalOutputMWh"}
        )

        df = df.sort_values("SiteID").reset_index(drop=True)

        return df

    def regional_maintenance_cost(self, df):
        df = df[
            df["MaintenanceStatus"] == "Completed"
        ].copy()

        df["MaintenanceCost"] = (
            df["DowntimeHours"] * 250
        )

        df = df.groupby("Region")["MaintenanceCost"].sum().reset_index()

        df = df.sort_values("Region").reset_index(drop=True)

        return df

